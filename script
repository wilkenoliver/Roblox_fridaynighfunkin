local function refreshSpecialNoteSkins()
    if st.SpecialNotes.Refreshing or not st.alive then return st.SpecialNotes.Ready end
    st.SpecialNotes.Refreshing = true

    local ok, result = pcall(function()
        local ui = getSpecialSettingsUi()
        if not ui or not ui.Configuration then return false end

        local ready = false
        if ui.Preview then
            for _, child in ipairs(ui.Preview:GetChildren()) do
                if child:FindFirstChild("LayeredSprite") then ready = true; break end
            end
        end

        local openedByUs = false
        if not ready then
            local topBar = PlayerGui:FindFirstChild("TopBar")
            local topFrame = topBar and topBar:FindFirstChild("Frame")
            local left = topFrame and topFrame:FindFirstChild("Left")
            local configButton = left and left:FindFirstChild("Configuration")
            if not configButton then return false end
            if not ui.Configuration.Visible then
                clickGuiButton(configButton)
                RunService.RenderStepped:Wait()
                RunService.RenderStepped:Wait()
                openedByUs = true
            end
            if ui.Preview then
                for _, child in ipairs(ui.Preview:GetChildren()) do
                    if child:FindFirstChild("LayeredSprite") then ready = true; break end
                end
            end
        end
        if not ready then return false end

        local originalTitle = ui.Title and ui.Title.Text or ""
        local originalSelection
        if string.find(originalTitle, "Poison", 1, true) then
            originalSelection = "Poison"
        elseif string.find(originalTitle, "Death", 1, true) then
            originalSelection = "Death"
        end

        local function capture(name)
            local button = ui[name]
            if not button or not clickGuiButton(button) then return nil end
            RunService.RenderStepped:Wait()
            return collectSpecialPreview(ui.Preview)
        end

        local death  = capture("Death")
        local poison = capture("Poison")

        if death and next(death.Images) then st.SpecialNotes.Death = death end
        if poison and next(poison.Images) then st.SpecialNotes.Poison = poison end

        if originalSelection and ui[originalSelection] then
            clickGuiButton(ui[originalSelection])
            RunService.RenderStepped:Wait()
        end

        if openedByUs then
            local topBar = PlayerGui:FindFirstChild("TopBar")
            local topFrame = topBar and topBar:FindFirstChild("Frame")
            local left = topFrame and topFrame:FindFirstChild("Left")
            local configButton = left and left:FindFirstChild("Configuration")
            if configButton and ui.Configuration.Visible then
                clickGuiButton(configButton)
            end
        end

        st.SpecialNotes.Ready =
            next(st.SpecialNotes.Death.Images) ~= nil
            and next(st.SpecialNotes.Poison.Images) ~= nil

        log("Special notes refreshed. Ready =", st.SpecialNotes.Ready)
        return st.SpecialNotes.Ready
    end)

    st.SpecialNotes.Refreshing = false
    if not ok then
        log("refreshSpecialNoteSkins error:", result)
        return false
    end
    return result
end

local function getSpecialNoteType(Arrow)
    if not Arrow then return nil end
    local head
    for _, child in ipairs(Arrow:GetChildren()) do
        if child:IsA("GuiObject") and child.ZIndex == 2 then head = child; break end
    end
    if not head then return nil end

    local death, poison = st.SpecialNotes.Death, st.SpecialNotes.Poison

    for _, imageObject in ipairs(head:GetChildren()) do
        if imageObject:IsA("ImageLabel") or imageObject:IsA("ImageButton") then
            local image = imageObject.Image
            local sig = imageSignature(imageObject)

            if sig then
                if death.Signatures[sig] then return "Death" end
                if poison.Signatures[sig] then return "Poison" end
            end

            local inDeath  = image and death.Images[image] or false
            local inPoison = image and poison.Images[image] or false

            if inDeath and not inPoison then return "Death" end
            if inPoison and not inDeath then return "Poison" end
        end
    end
    return nil
end

-- ============================================================
-- Humanização / decisão de hit
-- ============================================================
local function decideAction(isHoldNote)
    if st.missChance > 0 then
        local notesSinceLast = st.Stats.perfect + st.Stats.great + st.Stats.ok + st.Stats.miss - st.lastMissAt
        if notesSinceLast >= st.missCooldownNotes and math.random() * 100 < st.missChance then
            st.lastMissAt = st.Stats.perfect + st.Stats.great + st.Stats.ok + st.Stats.miss + 1
            return "Miss", 0
        end
    end

    if st.accuracy <= 0 or math.random() * 100 > st.accuracy then
        return "Miss", 0
    end

    local roll = math.random() * 100
    local quality
    if roll <= 70 then quality = "Perfect"
    elseif roll <= 95 then quality = "Great"
    else quality = "Ok" end

    local jitter = 0
    if st.humanize and st.jitterMs > 0 then
        local u1 = math.max(math.random(), 1e-9)
        local u2 = math.random()
        jitter = math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * u2) * (st.jitterMs / 1000)
    end

    local qualityOffset = (quality == "Perfect" and 0)
        or (quality == "Great" and 0.010)
        or (quality == "Ok" and 0.025) or 0

    if isHoldNote then qualityOffset = qualityOffset * 0.5 end

    return quality, jitter + qualityOffset
end

-- ============================================================
-- Judgment line
-- ============================================================
local function computeJudgmentY(Holder)
    if not Holder then return nil end
    local abs, size = Holder.AbsolutePosition, Holder.AbsoluteSize
    if not abs or not size or size.Y <= 0 then return nil end
    return abs.Y + size.Y
end

-- ============================================================
-- Watcher de notas
-- ============================================================
local noteWatchers = st.NoteWatchers

local function resetWatcher(w, holder, action)
    w.holder = holder
    w.action = action
    w.isHold = false
    w.judged = false
    w.started = os.clock()
    w.lastY = nil
    w.lastT = nil
    w.velocity = 0
    w.judgmentY = st.LaneJudgmentY[holder]
    w.extraDelay = 0
    w.decidedQuality = nil
    w.holdStarted = false
    w.framesSeen = 0
end

local function updateWatcherSample(w, arrow)
    if not arrow or not arrow.Parent then return end
    local y = arrow.AbsolutePosition.Y
    local now = os.clock()
    if w.lastY and w.lastT then
        local dt = now - w.lastT
        if dt > 1e-4 then
            local dy = y - w.lastY
            local v = dy / dt
            if w.velocity == 0 then
                w.velocity = v
            else
                -- 0 = sem suavização (usa amostra crua); >0 = EMA
                local a = (st.velocitySmoothing <= 0) and 1 or st.velocitySmoothing
                w.velocity = w.velocity * (1 - a) + v * a
            end
        end
    end
    w.lastY = y
    w.lastT = now
    w.framesSeen = (w.framesSeen or 0) + 1
end

local function performHit(w, context)
    local Holder = w.holder
    local action = w.action
    local Arrow  = w.arrowRef

    if not action or not Holder then return end
    if not st.auto then return end

    if context.laneDown[Holder] then
        context.release(Holder.Name, action)
    end

    context.press(Holder.Name, action)
    context.laneDown[Holder] = true
    context.laneCount[Holder] = (context.laneCount[Holder] or 0) + 1

    local holdNote = isHold(Arrow)
    if holdNote and st.enableHolds then
        w.holdStarted = true
        task.spawn(function()
            local untilTime = os.clock() + math.max(0.05, st.maxHold)
            while Arrow and Arrow.Parent and Arrow.Visible and st.auto
                  and os.clock() <= untilTime do
                if not isHold(Arrow) then break end
                task.wait(math.max(0.005, st.holdTick))
            end
            if st.humanize and st.jitterMs > 0 then
                task.wait(math.random() * (st.jitterMs / 1000))
            end
            context.laneCount[Holder] = math.max((context.laneCount[Holder] or 1) - 1, 0)
            if context.laneCount[Holder] <= 0 then
                context.laneCount[Holder] = 0
                if context.laneDown[Holder] then
                    context.release(Holder.Name, action)
                    context.laneDown[Holder] = false
                end
            end
        end)
    else
        task.spawn(function()
            task.wait(math.max(0, st.tapMs) / 1000)
            if st.relMs and st.relMs > 0 then
                task.wait(st.relMs / 1000)
            end
            context.laneCount[Holder] = math.max((context.laneCount[Holder] or 1) - 1, 0)
            if context.laneCount[Holder] <= 0 then
                context.laneCount[Holder] = 0
                if context.laneDown[Holder] then
                    context.release(Holder.Name, action)
                    context.laneDown[Holder] = false
                end
            end
        end)
    end
end

local AutoCtx -- forward declaration

local function noteWatcherTick()
    if not st.alive then return end

    local now = os.clock()
    local toRemove = nil

    for arrow, w in pairs(noteWatchers) do
        if not arrow.Parent or not arrow.Visible then
            if not w.judged and w.decidedQuality ~= "Miss" then
                st.Stats.miss += 1
            end
            toRemove = toRemove or {}
            table.insert(toRemove, arrow)
        elseif not st.auto then
            toRemove = toRemove or {}
            table.insert(toRemove, arrow)
        elseif not w.judged then
            updateWatcherSample(w, arrow)

            local jY = w.judgmentY
            if not jY then
                jY = computeJudgmentY(w.holder)
                w.judgmentY = jY
            end

            if jY then
                local y = arrow.AbsolutePosition.Y
                local dist = jY - y
                local v = w.velocity

                local timeToHit
                if v and v >= st.minVelocity then
                    timeToHit = dist / v
                end

                if timeToHit then
                    local lead = st.tapMs / 1000 * 0.5
                    local effective = timeToHit - lead - w.extraDelay + (st.off / 1000)

                    if effective <= 0 then
                        w.judged = true
                        performHit(w, AutoCtx)
                    end
                else
                    local elapsed = now - w.started
                    local fallback = (st.baseMs / 1000) - (st.off / 1000) - w.extraDelay
                    if elapsed >= fallback then
                        w.judged = true
                        performHit(w, AutoCtx)
                    end
                end
            end
        end
    end

    if toRemove then
        for _, arrow in ipairs(toRemove) do
            noteWatchers[arrow] = nil
        end
    end
end

-- ============================================================
-- Bind da música
-- ============================================================
local connections = {
    _list = {},
    add = function(self, signal, cb)
        local conn = signal:Connect(cb)
        self._list[#self._list + 1] = conn
        return conn
    end,
    disconnect = function(self)
        for _, conn in ipairs(self._list) do
            if typeof(conn) == "RBXScriptConnection" then
                pcall(function() conn:Disconnect() end)
            end
        end
        table.clear(self._list)
    end,
}

local function clearSongConnections()
    connections:disconnect()
    table.clear(st.Session)
    table.clear(st.ActionKeyCache)
    table.clear(st.LaneJudgmentY)
    table.clear(noteWatchers)
    releaseAll()
end

local function pickLocalField(fields)
    local best, bestScore
    for _, sideName in ipairs({"Left", "Right"}) do
        local side = fields:FindFirstChild(sideName)
        local inner = side and side:FindFirstChild("Inner")
        local lane1 = inner and inner:FindFirstChild("Lane1")
        if side and lane1 then
            local score = (side.ZIndex or 0) * 100000 + lane1.AbsoluteSize.X
            if not bestScore or score > bestScore then
                best, bestScore = side, score
            end
        end
    end
    return best
end

local function enqueueNote(Holder, Arrow, Action)
    local special = getSpecialNoteType(Arrow)
    if special == "Death"  and st.ignoreDeath  then st.Stats.skipped += 1; return end
    if special == "Poison" and st.ignorePoison then st.Stats.skipped += 1; return end

    local quality, extra = decideAction(isHold(Arrow))
    if quality == "Miss" then
        st.Stats.miss += 1
        log("Miss proposital/escolhido")
        return
    end
    if quality == "Perfect" then st.Stats.perfect += 1
    elseif quality == "Great"   then st.Stats.great += 1
    elseif quality == "Ok"      then st.Stats.ok += 1 end
    st.Stats.hits += 1

    local w = {
        arrowRef = Arrow,
        decidedQuality = quality,
        extraDelay = extra,
    }
    resetWatcher(w, Holder, Action)
    if not w.judgmentY then
        w.judgmentY = computeJudgmentY(Holder)
        st.LaneJudgmentY[Holder] = w.judgmentY
    end
    w.lastY = Arrow.AbsolutePosition.Y
    w.lastT = os.clock()

    noteWatchers[Arrow] = w
end

local function bindSong()
    clearSongConnections()

    local context = PlayerGui:FindFirstChild("VSRGContext")
    local window  = PlayerGui:FindFirstChild("Window")
    local gameFrame = window and window:FindFirstChild("Game")
    local fields  = gameFrame and gameFrame:FindFirstChild("Fields")
    if not (context and fields) then
        st.boundWindow = nil
        st.boundLanes = 0
        return false
    end

    local localField = pickLocalField(fields)
    local inner = localField and localField:FindFirstChild("Inner")
    if not inner then
        st.boundWindow = nil
        st.boundLanes = 0
        return false
    end

    local entries = {}
    for i = 1, 12 do
        local Holder = inner:FindFirstChild("Lane" .. i)
        local action = context:FindFirstChild("Lane" .. i)
        local notes = Holder and Holder:FindFirstChild("Notes")
        if Holder and action and notes then
            st.Session[Holder.Name] = action
            local jY = computeJudgmentY(Holder)
            if jY then st.LaneJudgmentY[Holder] = jY end
            table.insert(entries, { Holder = Holder, Notes = notes, Action = action })
        end
    end

    AutoCtx = {
        enabled = true,
        offsetMs = st.off,
        baseOffset = st.baseMs / 1000,
        tapMs = st.tapMs,
        relMs = st.relMs,
        holdTick = st.holdTick,
        maxHold = st.maxHold,
        laneDown = st.laneDown,
        laneCount = st.laneCount,
        press = pressLane,
        release = releaseLane,
    }

    for _, entry in ipairs(entries) do
        local Holder = entry.Holder
        local Notes  = entry.Notes
        local Action = entry.Action

        connections:add(Notes.ChildAdded, function(Arrow)
            task.defer(function()
                if not Arrow or not Arrow.Visible then return end
                if not st.auto then return end

                local jY = computeJudgmentY(Holder)
                if jY then st.LaneJudgmentY[Holder] = jY end

                if st.timingMode == "Auto" then
                    enqueueNote(Holder, Arrow, Action)
                else
                    local special = getSpecialNoteType(Arrow)
                    if special == "Death"  and st.ignoreDeath  then st.Stats.skipped += 1; return end
                    if special == "Poison" and st.ignorePoison then st.Stats.skipped += 1; return end

                    local quality, extra = decideAction(isHold(Arrow))
                    if quality == "Miss" then
                        st.Stats.miss += 1
                        return
                    end
                    if quality == "Perfect" then st.Stats.perfect += 1
                    elseif quality == "Great"   then st.Stats.great += 1
                    elseif quality == "Ok"      then st.Stats.ok += 1 end
                    st.Stats.hits += 1

                    local w = {
                        arrowRef = Arrow,
                        holder = Holder,
                        action = Action,
                        extraDelay = extra,
                    }
                    task.spawn(function()
                        local delay = st.baseMs / 1000 + st.off / 1000 + extra
                        if delay > 0 then task.wait(delay) end
                        if not st.auto or not Arrow.Parent or not Arrow.Visible then return end
                        performHit(w, AutoCtx)
                    end)
                end
            end)
        end)
    end

    st.boundWindow = window
    st.boundLanes = #entries
    log("bindSong: lanes bound =", #entries)
    return #entries > 0
end

-- ============================================================
-- Watch de janela / rebind
-- ============================================================
local function fieldWatch()
    if not st.alive then return end

    local window  = PlayerGui:FindFirstChild("Window")
    local context = PlayerGui:FindFirstChild("VSRGContext")

    if window ~= st.boundWindow then
        st.boundWindow = window
        if window and context then
            task.defer(bindSong)
        else
            releaseAll()
            table.clear(st.Session)
            table.clear(noteWatchers)
            st.boundLanes = 0
        end
    elseif window and context and next(st.Session) == nil then
        task.defer(bindSong)
    end

    if not st.auto then releaseAll() end
end

-- ============================================================
-- Unload
-- ============================================================
function st:Unload()
    if not self.alive then return end
    self.alive = false
    self.auto = false

    releaseAll()
    connections:disconnect()
    table.clear(noteWatchers)

    for _, key in ipairs({"FieldWatch","GuiWatch","ConfigWatch","SpecialPageWatch","NoteWatcherHeartbeat"}) do
        local c = self[key]
        if c then
            pcall(function() c:Disconnect() end)
            self[key] = nil
        end
    end

    for _, binding in pairs(self.ScriptBindings or {}) do
        if binding and binding.Parent then
            pcall(function() binding:Destroy() end)
        end
    end
    table.clear(self.ScriptBindings)
    table.clear(self.ActionKeyCache)
    table.clear(self.LaneJudgmentY)

    if self.RayfieldWindow and not self.RayfieldWindow.unloaded then
        pcall(function() self.RayfieldWindow:Unload() end)
    end
    self.RayfieldWindow = nil

    if ENV.__FunkyFridayAutoplayer == self then
        ENV.__FunkyFridayAutoplayer = nil
    end
    log("Unloaded.")
end

