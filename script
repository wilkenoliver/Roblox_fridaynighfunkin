-- ============================================================
-- Input helpers
-- ============================================================
local function getLaneKeyCode(action)
    if not action then return nil end
    local cached = st.ActionKeyCache[action]
    if cached and cached ~= Enum.KeyCode.Unknown then return cached end
    for _, child in ipairs(action:GetChildren()) do
        if child:IsA("InputBinding") then
            local kc = child.KeyCode
            if kc and kc ~= Enum.KeyCode.Unknown then
                st.ActionKeyCache[action] = kc
                return kc
            end
        end
    end
    return nil
end

local function getScriptBinding(action)
    if not action then return nil end
    local binding = st.ScriptBindings[action]
    if binding and binding.Parent == action then return binding end
    binding = Instance.new("InputBinding")
    binding.Name = "FFAutoplayerScriptBinding"
    binding.Type = Enum.InputBindingType.Scriptable
    binding.Parent = action
    st.ScriptBindings[action] = binding
    return binding
end

local function fireAction(action, down)
    if not action then return false end
    if st.inMode == "Scriptable Input" then
        if not HasScriptableInput then return false end
        local binding = getScriptBinding(action)
        if not binding then return false end
        return pcall(function() binding:Fire(down) end)
    end
    if st.inMode == "firesignal" then
        if not HasFireSignal then return false end
        return pcall(firesignal, down and action.Pressed or action.Released)
    end
    return false
end

local function pressLane(_, action)
    if st.inMode ~= "Virtual Input" then
        fireAction(action, true)
        return
    end
    local kc = getLaneKeyCode(action)
    if kc and HasVirtualInput then
        pcall(function() VirtualInputManager:SendKeyEvent(true, kc, false, game) end)
    end
end

local function releaseLane(_, action)
    if st.inMode ~= "Virtual Input" then
        fireAction(action, false)
        return
    end
    local kc = getLaneKeyCode(action)
    if kc and HasVirtualInput then
        pcall(function() VirtualInputManager:SendKeyEvent(false, kc, false, game) end)
    end
end

local function releaseAll()
    for Holder, down in pairs(st.laneDown) do
        if down then
            local action = st.Session[Holder.Name]
            if action then releaseLane(Holder.Name, action) end
            st.laneDown[Holder] = false
        end
    end
    for Holder in pairs(st.laneCount) do
        st.laneCount[Holder] = 0
    end
end

